// ============================================================
// پلتفرم عملیاتی سازمانی — پایلوت ۹۰ روزه (پروژه ideaone)
// معماری: مونولیت ماژولار + رجیستری ماژول دیتابیس‌محور
// مطابق توصیه‌های گزارش ممیزی (بخش B.1 و B.2)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // لایه سوم ماندگاری (۱۴۰۵/۰۶/۱۰): از SQLite محلی به Neon (Postgres ابری) مهاجرت شد —
  // DATABASE_URL خارج از دیسک سندباکس → ریست محیط روی داده بی‌اثر (سند پژوهش §۷).
  // راز اتصال فقط در .env (gitignore) — هرگز کامیت نشود (AGENTS.md).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- هسته: چندشرکتی ----------------
// تصمیم D2 گزارش ممیزی: «شرکت = مستأجر»؛ فیلد tenant_id حذف شد.
model Company {
  id        String   @id @default(cuid())
  code      String   @unique // HOLD, ARAD, ISFAHAN, NILO, LIAN
  name      String
  legalName String?
  type      String   @default("COMPANY") // GROUP | COMPANY
  city      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  memberships      Membership[]
  products         Product[]
  warehouses       Warehouse[]
  warehouseDocs    WarehouseDoc[]
  goodsRequests    GoodsRequest[]
  letters          Letter[]
  partnerInstances PartnerInstance[]
  moduleActivations ModuleActivation[]
  settings          CompanySetting[]
  auditLogs        AuditLog[]
  counters         DocCounter[]
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // نام کاربری (ورود)
  fullName     String
  passwordHash String
  jobTitle     String?
  isAdmin      Boolean  @default(false) // مدیر پلتفرم (رجیستری ماژول)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships    Membership[]
  sessions       Session[]
  notifications  Notification[]
  lettersCreated Letter[]         @relation("LetterCreator")
  letterHoldings Letter[]         @relation("LetterHolder")
  referralsFrom  LetterReferral[] @relation("RefFrom")
  referralsTo    LetterReferral[] @relation("RefTo")
  auditLogs      AuditLog[]
  goodsRequests  GoodsRequest[]
  knownDevices   KnownDevice[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String   @default("OPERATOR") // ADMIN | MANAGER | OPERATOR | VIEWER
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId]) // P1-T11 — ماتریس اعضای شرکت (کاربران یک شرکت)
}

model Session {
  id         String   @id @default(cuid()) // توکن نشست
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String? // شرکت فعال نشست
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // P1-T8: آخرین فعالیت نشست (به‌روزرسانی گلوگاه‌دار)
  ip         String? // P1-T8: نشانی نشست
  userAgent  String? // P1-T8: عامل کاربر نشست
  deviceKey  String? // P1-T19: کلید دستگاه (اثر انگشت UA)

  @@index([userId, expiresAt]) // P1-T11 — فهرست دستگاه‌های فعال + پاکسازی منقضی‌ها
}

// P1-T19: دستگاه‌های شناخته‌شده کاربر — تشخیص «ورود از دستگاه جدید»
// کلید دستگاه = هش SHA-256 از عامل کاربر نرمال‌شده؛ مستقل از چرخه حیات نشست‌ها
// (خروج/انقضا دستگاه را «فراموش» نمی‌کند تا اعلان تکراری نشود)
model KnownDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceKey String
  userAgent String?
  ip        String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([userId, deviceKey])
}

// P0.5-T3: تلاش‌های ورود ناموفق — ماندگار در DB (چند-نمونه امن).
// قبلاً محدودساز نرخ در حافظه بود: ری‌استارت سرویس پنجره حمله را ریست می‌کرد.
// پنجره لغزان ۶۰ثانیه‌ای از همین ردیف‌ها شمرده می‌شود؛ ردیف‌های کهنه (بیش از
// ۲۴ ساعت) پاک‌سازی دوره‌ای می‌شوند — ۲۴ ساعت برای جرم‌یابی امنیتی نگه داشته می‌شود.
// ⚠ ایجاد جدول با CREATE مستقیم (scripts/apply-p05-t3-schema.ts) — db push
// جدول‌های FTS دستی را می‌اندازد (درس T2/۱۰۶۸).
model LoginAttempt {
  id       String   @id @default(cuid())
  username String
  ip       String
  at       DateTime @default(now())

  @@index([username, ip, at])
}

// ---------------- رجیستری ماژول (پلاگین‌محور) ----------------
// جایگزین Module Federation طبق توصیه B.1.3 گزارش ممیزی
// تاکسونومی سه‌لایه (ADR-008): FOUNDATION | OPERATIONS | INTELLIGENCE
// پوشش کامل ۲۶ پلاگین سند منبع (بخش ۱۰) + ۵ قابلیت بستر
model PlatformModule {
  id          String @id @default(cuid())
  code        String @unique // office-automation, warehouse, finance, ...
  name        String
  description String
  icon        String
  layer       String @default("OPERATIONS") // FOUNDATION | OPERATIONS | INTELLIGENCE
  domain      String @default("general") // office | warehouse | master-data | manufacturing | finance | commercial | hr | ai | general
  targetPhase String @default("P0") // فاز نقشه راه تحقق
  dependsOn   String @default("[]") // JSON — وابستگی به پلاگین‌های دیگر
  version     String @default("1.0.0")
  status      String @default("ACTIVE") // ACTIVE | INACTIVE
  sortOrder   Int    @default(0)

  activations ModuleActivation[]
  menus       ModuleMenu[]
}

// منوی پلاگین — تفکیک «پلاگین» از «ناوبری» (ADR-008)
// یک پلاگین می‌تواند چند نما داشته باشد (مثل انبار: موجودی/اسناد/درخواست)
model ModuleMenu {
  id        String        @id @default(cuid())
  moduleId  String
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  viewKey   String // کلید نما در app-shell: cartable, letters, stock, ...
  label     String
  icon      String
  sortOrder Int           @default(0)

  @@unique([moduleId, viewKey])
}

model ModuleActivation {
  id        String         @id @default(cuid())
  moduleId  String
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enabled   Boolean        @default(true)

  @@unique([moduleId, companyId])
}

// ---------------- مستر دیتا ----------------
// محصول کاشی: سلسله‌مراتب خط → آیتم (رنگ/ابعاد) → واریانت موجودی (تون/کالیبر/درجه)
model Product {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  code            String   @unique
  name            String
  productLine     String // خط محصول
  size            String // ابعاد
  color           String // رنگ
  surface         String? // سطح: پولیش / مات / روستیک / LT
  baseUnit        String   @default("m2")
  cartonArea      Float    @default(0) // مترمربع هر کارتن
  cartonsPerPallet Int     @default(0) // تعداد کارتن هر پالت
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  stockItems   StockItem[]
  docItems     DocItem[]
  requestItems GoodsRequestItem[]
}

// الگوی «رکورد طلایی گروه + نمونه عملیاتی شرکت» (توصیه B.2.2)
model Partner {
  id         String  @id @default(cuid())
  kind       String // CUSTOMER | SUPPLIER
  goldenName String
  nationalId String?
  isActive   Boolean @default(true)

  instances PartnerInstance[]
}

model PartnerInstance {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  accountCode String? // کد حساب تفصیلی شرکت
  creditLimit Float    @default(0)
  terms       String? // شرایط پرداخت
  note        String?

  @@unique([partnerId, companyId])
}

model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  code      String
  name      String
  kind      String  @default("PHYSICAL") // PHYSICAL | VIRTUAL | WORKSTATION — حکم نشست ۱۰ (فیزیکی/مجازی/پای‌کار)
  isActive  Boolean @default(true)

  stockItems StockItem[]
  docs      WarehouseDoc[] @relation("DocWarehouse")
  toDocs    WarehouseDoc[] @relation("DocToWarehouse")
  requests  GoodsRequest[]

  @@unique([companyId, code])
}

// ---------------- انبار ----------------
model StockItem {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  tone        String    @default("") // تون
  caliber     String    @default("") // کالیبر
  grade       String    @default("1") // درجه ۱ / ۲ / ضایعات
  qtyM2       Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId, tone, caliber, grade])
  @@index([productId]) // P1-T11 — فیلتر کالا در فهرست موجودی (پیشوند warehouseId توسط unique پوشش داده می‌شود)
}

model WarehouseDoc {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  docNumber     Int
  type          String // RECEIPT | ISSUE | TRANSFER | COUNT
  warehouseId   String
  warehouse     Warehouse  @relation("DocWarehouse", fields: [warehouseId], references: [id])
  toWarehouseId String?
  toWarehouse   Warehouse? @relation("DocToWarehouse", fields: [toWarehouseId], references: [id])
  partnerName   String?
  status        String     @default("DRAFT") // DRAFT | POSTED | CANCELLED
  docDate       DateTime   @default(now())
  note          String?
  createdById   String?
  items         DocItem[]

  @@unique([companyId, type, docNumber])
  // P1-T11 — نمایه‌های مسیرهای داغ
  @@index([companyId, docDate, docNumber]) // فهرست اصلی: جدیدترین سند (ترتیب ثانویه شماره)
  @@index([companyId, status]) // فیلتر وضعیت + groupBy داشبورد
  @@index([warehouseId]) // فیلتر انبار (شامل انبار مقصد انتقال)
}

model DocItem {
  id        String       @id @default(cuid())
  docId     String
  doc       WarehouseDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  tone      String       @default("")
  caliber   String       @default("")
  grade     String       @default("1")
  qtyM2     Float        @default(0)
  note      String?

  @@index([docId]) // P1-T11 — اقلام سند در include فهرست/جزئیات
  @@index([productId]) // P1-T11 — ردیابی کالا در اسناد
}

model GoodsRequest {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  reqNumber   Int
  requesterId String
  requester   User      @relation(fields: [requesterId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | FULFILLED
  neededFor   String? // واحد مصرف‌کننده
  note        String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  items       GoodsRequestItem[]

  // P1-T11 — نمایه‌های مسیرهای داغ
  @@index([companyId, createdAt]) // فهرست اصلی
  @@index([companyId, status]) // فیلتر وضعیت + شمارش در انتظار داشبورد
  @@index([requesterId]) // درخواست‌های من
}

model GoodsRequestItem {
  id        String       @id @default(cuid())
  requestId String
  request   GoodsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  qtyM2     Float        @default(0)

  @@index([requestId]) // P1-T11 — اقلام درخواست در include
}

// ---------------- اتوماسیون اداری / کارتابل ----------------
model Letter {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  number          Int // شماره‌گذاری خودکار سالانه
  type            String // INCOMING | OUTGOING | INTERNAL
  subject         String
  body            String
  senderTitle     String? // فرستنده (نامه وارده)
  receiverTitle   String? // گیرنده بیرونی (نامه صادره)
  confidentiality String    @default("NORMAL") // NORMAL | CONFIDENTIAL | SECRET
  urgency         String    @default("NORMAL") // NORMAL | URGENT
  deadlineAt      DateTime?
  status          String    @default("IN_PROGRESS") // DRAFT | IN_PROGRESS | ANSWERED | ARCHIVED
  currentHolderId String?
  currentHolder   User?     @relation("LetterHolder", fields: [currentHolderId], references: [id])
  creatorId       String
  creator         User      @relation("LetterCreator", fields: [creatorId], references: [id])
  aiCategory      String? // طبقه‌بندی هوش مصنوعی (پس از تأیید انسانی HITL)
  aiSummary       String? // خلاصه هوش مصنوعی (پس از تأیید انسانی HITL)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  referrals LetterReferral[]

  // P1-T11 — نمایه‌های مسیرهای داغ (فهرست‌ها + شمارش‌های داشبورد)
  @@index([companyId, createdAt]) // فهرست اصلی: دامنه شرکت + جدیدترین
  @@index([companyId, status]) // فیلتر وضعیت + شمارش داشبورد
  @@index([currentHolderId, status]) // کارتابل من (inbox)
  @@index([creatorId, createdAt]) // صادره‌های من
}

model LetterReferral {
  id         String    @id @default(cuid())
  letterId   String
  letter     Letter    @relation(fields: [letterId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User      @relation("RefFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User      @relation("RefTo", fields: [toUserId], references: [id])
  action     String // REFER | ANSWER | APPROVE | ARCHIVE
  note       String?
  // P2-T4 — متن پاسخ: محتوای پاسخ روی اقدام ANSWER (الزامی)؛ note یادداشت اقدام است نه متن پاسخ
  answerText String?
  deadlineAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([letterId, createdAt]) // P1-T11 — سلسله ارجاع‌های نامه (نمای جزئیات)
}

// ---------------- زیرساخت مشترک ----------------
model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  kind       String   @default("INFO") // INFO | LETTER | WAREHOUSE | REQUEST
  targetView String?
  isRead     Boolean  @default(false)
  // P2-T11 — کلید عدم‌تکرار یادآورها: یکتا به‌ازای (نامه × نقطه یادآور)؛ تکرار = P2002 → رد بی‌صدا
  // (چند NULL مجاز است — رفتار استاندارد unique در SQLite برای اعلان‌های عادی بدون کلید)
  dedupKey   String?  @unique
  createdAt  DateTime @default(now())

  @@index([userId, createdAt]) // P1-T11 — زنگ اعلان: ۳۰ اعلان آخر + شمارش خوانده‌نشده (داغ‌ترین کوئری)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  action    String // LOGIN | LOGOUT | CREATE | POST | REFER | ARCHIVE | MODULE_TOGGLE | AI_APPLY ...
  entity    String
  entityId  String?
  details   String? // JSON
  createdAt DateTime @default(now())

  // P1-T11 — نمایه‌های سجل (فهرست حسابرسی + گزارش‌های داشبورد + ورودهای ناموفق)
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// باس رویداد درون‌برنامه‌ای — الگوی Outbox (توصیه B.1.4)
model OutboxEvent {
  id          String    @id @default(cuid())
  type        String // letter.created | letter.referred | doc.posted | request.approved ...
  payload     String // JSON
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt]) // P1-T11 — برداشت پردازشگر رویداد (خیل رویداد پس از پردازش)
}

// شمارنده شماره اسناد به تفکیک شرکت/نوع/سال
model DocCounter {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  scope     String // LETTER | WHDOC | GOODSREQ
  year      Int
  value     Int     @default(0)

  @@unique([companyId, scope, year])
}

// ---------------- سرویس‌های هسته (ADR-009 — تکمیل ۱۸ سرویس سند منسب ۵.۱) ----------------

// تنظیمات per-company (P1-T29/T30) — کلید-مقدار ساده؛ نمونه‌ها:
//   requests.visibility = ALL | SELF_MANAGERS   (دید درخواست کالا)
//   requests.notifyCeilingM2 = عدد (سقف اعلان مدیران؛ ۰ = همه)
model CompanySetting {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}

// Feature Flags — فعال‌سازی تدریجی و کنترل‌شده قابلیت‌ها (سرویس ۱۳: Configuration & Feature Flags)
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // ai.letter-assist, scheduler.outbox-processor, ...
  description String
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// هسته Storage — اشیای فایل (سرویس ۱۱: File & Document Storage)
// آداپتر سندباکس: فایل‌سیستم محلی (.storage/)؛ استقرار تولیدی: S3/MinIO با همین قرارداد
model FileObject {
  id         String   @id @default(cuid())
  storageKey String   @unique // letters/1405/<cuid>.pdf
  fileName   String
  mimeType   String
  sizeBytes  Int      @default(0)
  sha256     String
  createdAt  DateTime @default(now())

  attachments Attachment[]
}

// پیوست چندریختی موجودیت‌های کسب‌وکار (نامه، سند انبار، قرارداد در آینده)
model Attachment {
  id           String     @id @default(cuid())
  entityType   String // letter | ...
  entityId     String
  fileObjectId String
  fileObject   FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)
  uploadedById String?
  createdAt    DateTime   @default(now())

  @@index([entityType, entityId])
}

// هسته Scheduler — کارهای دوره‌ای (سرویس ۱۲: Scheduler / Background Jobs)
model ScheduledJob {
  id          String    @id @default(cuid())
  key         String    @unique // outbox-processor | health-monitor
  name        String
  intervalSec Int       @default(60)
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  lastStatus  String? // OK | ERROR
  lastError   String?
  note        String?
}

// هسته AI Gateway — سجل هر فراخوانی مدل (سرویس ۱۷: AI Gateway)
// جدول تلمتری پرنوشت است؛ عمداً بدون FK به User/Company
model AiInvocation {
  id        String   @id @default(cuid())
  task      String // letter.classify-summarize
  provider  String   @default("zai")
  model     String?
  ok        Boolean  @default(true)
  error     String?
  latencyMs Int      @default(0)
  userId    String?
  companyId String?
  createdAt DateTime @default(now())
}

// هسته Integration Bus — کانکتورهای یکپارچه‌سازی (سرویس ۱۸، پوشه integration سند منبع)
model IntegrationConnector {
  id        String @id @default(cuid())
  code      String @unique // tax-connector, bank-connector, ...
  name      String
  kind      String // TAX | BANK | ATTENDANCE | E_INVOICE | LEGACY | GENERIC
  status    String @default("PLANNED") // PLANNED | CONFIGURED | LIVE
  direction String @default("OUTBOUND") // OUTBOUND | INBOUND | BIDIRECTIONAL
  endpoint  String?
  note      String?
}

// هسته Reporting Metadata — کاتالوگ گزارش‌های پلتفرم (سرویس ۱۶)
model ReportDefinition {
  id          String @id @default(cuid())
  code        String @unique // letters.register, stock.by-grade, ...
  name        String
  moduleCode  String
  category    String // OPERATIONAL | MANAGEMENT | COMPLIANCE
  engine      String @default("BUILTIN") // BUILTIN | AI
  targetPhase String @default("P0")
  params      String @default("{}") // JSON — پارامترهای استاندارد گزارش
}

// ---------------- موتور کدگذاری ساختارمحور (P4 پیش‌دزش — «کد به‌عنوان جمله») ----------------
// طرحواره = دستور زبانِ کد؛ جزء = نقش کلمه (ENUM فهرست بسته / COUNTER شمارنده)؛
// عمومی برای هر خانواده قلم: کاشی (۲۰ کاراکتری «دستورالعمل کدگذاری محصولات»)،
// تجهیزات ثابت، قطعات یدکی، مواد اولیه — کد مادر = n جزء ابتدایی (تبصره ۱-۲ سند).
model CodeScheme {
  id          String   @id @default(cuid())
  companyId   String? // null = طرحواره سراسری هلدینگ؛ مقدار = اختصاصی همان شرکت (اولویت بالاتر)
  code        String // 'tile' | 'equipment' | 'spare-part' | 'raw-material'
  name        String // فارسی
  description String?
  itemFamily  String   @default("PRODUCT") // PRODUCT | EQUIPMENT | SPARE_PART | RAW_MATERIAL
  separator   String   @default("") // جداکننده بین اجزا ('' برای کاشی، '-' برای تجهیزات)
  motherSegments Int? // شمار اجزای ابتدایی که «کد مادر» را می‌سازند (کاشی = 9 جزء = 12 کاراکتر)
  isActive    Boolean  @default(true)
  segments    CodeSegment[]

  @@unique([companyId, code])
  @@index([companyId])
}

model CodeSegment {
  id         String       @id @default(cuid())
  schemeId   String
  scheme     CodeScheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  position   Int // 1..n از چپ
  key        String // 'glaze' | 'thickness' | 'design' ...
  label      String // «نوع لعاب»
  length     Int // 1..3
  kind       String // ENUM | COUNTER
  required   Boolean      @default(true)
  mapsTo     String? // نگاشت معنایی به فیلد مستردیتا: 'size' | 'color' | 'surface' | 'productLine'
  enumValues CodeEnumValue[]

  @@unique([schemeId, key])
  @@index([schemeId])
}

model CodeEnumValue {
  id        String       @id @default(cuid())
  segmentId String
  segment   CodeSegment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  code      String // 'T' | '60' | 'IS'
  label     String // «براق (ترانس)»
  sortOrder Int          @default(0)

  @@unique([segmentId, code])
}
